# SUPABASE CONFIGURATION (Public Frontend Client)
# Get these from your Supabase Project Settings > API
# CAUTION: Never put SUPABASE_SERVICE_ROLE_KEY here. Only use the anon/publishable key!
VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key_here

# GOOGLE GEMINI AI (Optional client testing key; For production, set GEMINI_API_KEY in Supabase Edge Function Secrets)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# SECURITY REMINDER:
# 1. Do NOT commit your actual `.env` file to Git or public repositories.
# 2. Keep private secret keys inside Supabase Vault / Edge Function Environment Secrets.

